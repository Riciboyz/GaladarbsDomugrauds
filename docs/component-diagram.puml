@startuml DomuGrauds Component Architecture

!theme plain
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle
skinparam packageStyle rectangle

package "Frontend (Next.js App)" {
    package "Layout & Providers" {
        component [RootLayout] as Layout
        component [Providers] as Providers
        component [ErrorBoundary] as ErrorBoundary
        component [GlobalWeatherTheme] as WeatherTheme
    }
    
    package "Context Providers" {
        component [UserContext] as UserCtx
        component [ThreadContext] as ThreadCtx
        component [GroupContext] as GroupCtx
        component [WebSocketContext] as WSCtx
        component [NotificationContext] as NotifCtx
        component [ToastContext] as ToastCtx
        component [TopicDayContext] as TopicCtx
        component [WeatherContext] as WeatherCtx
    }
    
    package "Main Application" {
        component [MainApp] as MainApp
        component [AuthPage] as AuthPage
        component [Page] as Page
    }
    
    package "Core Components" {
        component [Sidebar] as Sidebar
        component [Feed] as Feed
        component [Profile] as Profile
        component [Groups] as Groups
        component [Notifications] as Notifications
        component [Search] as Search
        component [Settings] as Settings
    }
    
    package "Thread Components" {
        component [ThreadCard] as ThreadCard
        component [CreateThread] as CreateThread
        component [SimpleCreateThread] as SimpleCreateThread
        component [RealtimeChat] as RealtimeChat
    }
    
    package "Group Components" {
        component [GroupChat] as GroupChat
        component [GroupManagement] as GroupManagement
        component [GroupCard] as GroupCard
    }
    
    package "UI Components" {
        component [Button] as Button
        component [Input] as Input
        component [Modal] as Modal
        component [Toast] as Toast
        component [LoadingState] as LoadingState
        component [Avatar] as Avatar
        component [Badge] as Badge
        component [Card] as Card
        component [Dropdown] as Dropdown
        component [FileUpload] as FileUpload
        component [ImageGallery] as ImageGallery
        component [VideoPlayer] as VideoPlayer
        component [AudioPlayer] as AudioPlayer
        component [RichTextEditor] as RichTextEditor
        component [MarkdownEditor] as MarkdownEditor
        component [EmojiPicker] as EmojiPicker
        component [ThemeToggle] as ThemeToggle
        component [WeatherWidget] as WeatherWidget
        component [WeatherEffects] as WeatherEffects
    }
    
    package "Utility Components" {
        component [KeyboardShortcuts] as KeyboardShortcuts
        component [InfiniteScroll] as InfiniteScroll
        component [VirtualScroll] as VirtualScroll
        component [LazyLoad] as LazyLoad
        component [CommandPalette] as CommandPalette
        component [DataTable] as DataTable
        component [KanbanBoard] as KanbanBoard
        component [Calendar] as Calendar
        component [Chart] as Chart
        component [ProgressBar] as ProgressBar
        component [Pagination] as Pagination
        component [Breadcrumb] as Breadcrumb
        component [Tabs] as Tabs
        component [Accordion] as Accordion
        component [Carousel] as Carousel
        component [Drawer] as Drawer
        component [Popover] as Popover
        component [Tooltip] as Tooltip
        component [ContextMenu] as ContextMenu
        component [DragAndDrop] as DragAndDrop
        component [FormBuilder] as FormBuilder
        component [CodeEditor] as CodeEditor
        component [HashtagInput] as HashtagInput
        component [Checkbox] as Checkbox
        component [Radio] as Radio
        component [Switch] as Switch
        component [Textarea] as Textarea
        component [Skeleton] as Skeleton
        component [Progress] as Progress
        component [Alert] as Alert
    }
    
    package "Admin Components" {
        component [AdminPanel] as AdminPanel
        component [DailyTopicBanner] as DailyTopicBanner
        component [TopicSubmission] as TopicSubmission
        component [TopicDays] as TopicDays
    }
}

package "API Routes (Backend)" {
    package "Authentication" {
        component [Auth/Login] as AuthLogin
        component [Auth/Register] as AuthRegister
        component [Auth/Logout] as AuthLogout
        component [Auth/Me] as AuthMe
        component [Auth/2FA/Verify] as Auth2FA
        component [Auth/2FA/TestSend] as Auth2FATest
    }
    
    package "User Management" {
        component [Users/Route] as UsersRoute
        component [Users/Follow] as UsersFollow
        component [Users/Followers] as UsersFollowers
        component [Users/Following] as UsersFollowing
        component [Users/Search] as UsersSearch
    }
    
    package "Thread Management" {
        component [Threads/Route] as ThreadsRoute
        component [Threads/Search] as ThreadsSearch
        component [Threads/Db] as ThreadsDb
    }
    
    package "Group Management" {
        component [Groups/Route] as GroupsRoute
        component [Groups/Chat] as GroupsChat
        component [Groups/Invite] as GroupsInvite
        component [Groups/Join] as GroupsJoin
        component [Groups/Members] as GroupsMembers
    }
    
    package "Content Management" {
        component [DailyTopic/Route] as DailyTopicRoute
        component [TopicSubmissions/Route] as TopicSubmissionsRoute
        component [Notifications/Route] as NotificationsRoute
        component [Upload/Route] as UploadRoute
        component [Upload/Chat/Route] as UploadChatRoute
    }
    
    package "External Services" {
        component [Weather/Route] as WeatherRoute
        component [WebSocket/Route] as WebSocketRoute
    }
    
    package "Admin APIs" {
        component [Admin/DailyTopics/Route] as AdminDailyTopics
        component [Admin/Users/Route] as AdminUsers
    }
}

package "Database Layer" {
    component [SQLite Database] as SQLiteDB
    component [MySQL Database] as MySQLDB
    component [Database Queries] as DBQueries
    component [Database Schema] as DBSchema
    component [Database Migrations] as DBMigrations
}

package "WebSocket Server" {
    component [WebSocket Server] as WSServer
    component [WebSocket Enhanced] as WSServerEnhanced
    component [Realtime Features] as RealtimeFeatures
}

package "External Services" {
    component [Weather API] as WeatherAPI
    component [File Upload Service] as FileUploadService
    component [Email Service] as EmailService
}

' Layout and Provider Relationships
Layout --> Providers
Providers --> ErrorBoundary
Providers --> WeatherTheme
Providers --> UserCtx
Providers --> ThreadCtx
Providers --> GroupCtx
Providers --> WSCtx
Providers --> NotifCtx
Providers --> ToastCtx
Providers --> TopicCtx
Providers --> WeatherCtx

' Main App Structure
Layout --> MainApp
MainApp --> AuthPage
MainApp --> Page
MainApp --> Sidebar
MainApp --> Feed
MainApp --> Profile
MainApp --> Groups
MainApp --> Notifications
MainApp --> Search
MainApp --> Settings

' Thread System
Feed --> ThreadCard
Feed --> CreateThread
Feed --> SimpleCreateThread
ThreadCard --> RealtimeChat
ThreadCard --> Avatar
ThreadCard --> Button
ThreadCard --> Modal

' Group System
Groups --> GroupChat
Groups --> GroupManagement
Groups --> GroupCard
GroupChat --> RealtimeChat
GroupChat --> FileUpload
GroupChat --> ImageGallery
GroupChat --> VideoPlayer
GroupChat --> AudioPlayer

' UI Components Usage
MainApp --> Button
MainApp --> Input
MainApp --> Modal
MainApp --> Toast
MainApp --> LoadingState
MainApp --> KeyboardShortcuts
MainApp --> InfiniteScroll
MainApp --> ThemeToggle
MainApp --> WeatherWidget
MainApp --> WeatherEffects

' Admin Components
MainApp --> AdminPanel
AdminPanel --> DailyTopicBanner
AdminPanel --> TopicSubmission
AdminPanel --> TopicDays

' Context Dependencies
MainApp --> UserCtx
MainApp --> ThreadCtx
MainApp --> GroupCtx
MainApp --> WSCtx
MainApp --> NotifCtx
MainApp --> ToastCtx
MainApp --> TopicCtx
MainApp --> WeatherCtx

' API Connections
UserCtx --> UsersRoute
UserCtx --> UsersFollow
UserCtx --> UsersFollowers
UserCtx --> UsersFollowing
UserCtx --> UsersSearch

ThreadCtx --> ThreadsRoute
ThreadCtx --> ThreadsSearch

GroupCtx --> GroupsRoute
GroupCtx --> GroupsChat
GroupCtx --> GroupsInvite
GroupCtx --> GroupsJoin
GroupCtx --> GroupsMembers

WSCtx --> WSServer
WSCtx --> WebSocketRoute

NotifCtx --> NotificationsRoute
ToastCtx --> Toast
TopicCtx --> DailyTopicRoute
TopicCtx --> TopicSubmissionsRoute
WeatherCtx --> WeatherRoute

' Authentication Flow
AuthPage --> AuthLogin
AuthPage --> AuthRegister
AuthPage --> AuthLogout
AuthPage --> AuthMe
AuthPage --> Auth2FA
AuthPage --> Auth2FATest

' File Upload
FileUpload --> UploadRoute
FileUpload --> UploadChatRoute
FileUpload --> FileUploadService

' Database Connections
UsersRoute --> SQLiteDB
UsersRoute --> MySQLDB
UsersRoute --> DBQueries
ThreadsRoute --> SQLiteDB
ThreadsRoute --> DBQueries
GroupsRoute --> SQLiteDB
GroupsRoute --> DBQueries
DailyTopicRoute --> SQLiteDB
DailyTopicRoute --> DBQueries
NotificationsRoute --> SQLiteDB
NotificationsRoute --> DBQueries

' WebSocket Connections
WSServer --> SQLiteDB
WSServer --> DBQueries
WSServerEnhanced --> SQLiteDB
WSServerEnhanced --> DBQueries
RealtimeFeatures --> WSServer
RealtimeFeatures --> WSServerEnhanced

' External Service Connections
WeatherRoute --> WeatherAPI
AuthLogin --> EmailService
AuthRegister --> EmailService
Auth2FA --> EmailService

' Admin API Connections
AdminPanel --> AdminDailyTopics
AdminPanel --> AdminUsers
AdminDailyTopics --> SQLiteDB
AdminUsers --> SQLiteDB

note right of MainApp
  Main application component
  that orchestrates all features
  and manages navigation
end note

note right of WSCtx
  WebSocket context manages
  real-time communication
  for threads, groups, and
  notifications
end note

note right of SQLiteDB
  Primary database for
  development and production
  with SQLite backend
end note

note right of WSServer
  WebSocket server handles
  real-time features like
  live chat, typing indicators,
  and instant notifications
end note

@enduml