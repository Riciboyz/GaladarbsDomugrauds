@startuml Frontend System Component Diagram - DomuGrauds

!theme plain
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam noteBackgroundColor #F8F9FA
skinparam noteBorderColor #E9ECEF

title Frontend System Component Diagram - DomuGrauds

package "Frontend System Architecture" {
    
    package "App Structure" {
        component [RootLayout] as Layout {
            - Inter & Playfair fonts
            - Global CSS & SCSS themes
            - Error boundary wrapper
        }
        
        component [Providers] as Providers {
            - Context providers wrapper
            - Global state management
        }
        
        component [ErrorBoundary] as ErrorBoundary {
            - Error catching
            - Fallback UI
        }
        
        component [GlobalWeatherTheme] as WeatherTheme {
            - Dynamic theme switching
            - Weather-based styling
        }
    }
    
    package "State Management Layer" {
        component [UserContext] as UserCtx {
            - Current user state
            - Users list
            - Follow/unfollow logic
            - Authentication status
        }
        
        component [ThreadContext] as ThreadCtx {
            - Threads state
            - Real-time updates
            - Thread CRUD operations
            - Search functionality
        }
        
        component [GroupContext] as GroupCtx {
            - Groups state
            - Group membership
            - Group management
            - Real-time group updates
        }
        
        component [WebSocketContext] as WSCtx {
            - WebSocket connection
            - Real-time messaging
            - Connection status
            - Message handling
        }
        
        component [NotificationContext] as NotifCtx {
            - Notifications state
            - Real-time notifications
            - Notification management
        }
        
        component [ToastContext] as ToastCtx {
            - Toast messages
            - Success/error feedback
            - Temporary notifications
        }
        
        component [TopicDayContext] as TopicCtx {
            - Daily topics
            - Topic submissions
            - Topic management
        }
        
        component [WeatherContext] as WeatherCtx {
            - Weather data
            - Theme switching
            - Weather effects
        }
    }
    
    package "Main Application" {
        component [MainApp] as MainApp {
            - Main navigation
            - Tab management
            - Content rendering
            - Keyboard shortcuts
        }
        
        component [AuthPage] as AuthPage {
            - Login/Register forms
            - Authentication UI
            - 2FA handling
        }
        
        component [Page] as Page {
            - Landing page
            - Public content
        }
    }
    
    package "Navigation System" {
        component [Sidebar] as Sidebar {
            - Navigation menu
            - Tab switching
            - User profile access
        }
        
        component [KeyboardShortcuts] as KeyboardShortcuts {
            - Global shortcuts
            - Navigation shortcuts
            - Quick actions
        }
    }
    
    package "Core Features" {
        component [Feed] as Feed {
            - Thread display
            - Filtering (all/following)
            - Real-time updates
            - Create thread button
        }
        
        component [Profile] as Profile {
            - User profile display
            - Profile editing
            - Follow/unfollow actions
            - User statistics
        }
        
        component [Groups] as Groups {
            - Group listing
            - Group creation
            - Join/leave groups
            - Group search
        }
        
        component [Notifications] as Notifications {
            - Notification list
            - Mark as read
            - Notification types
        }
        
        component [Search] as Search {
            - Global search
            - Thread search
            - User search
            - Advanced filters
        }
        
        component [Settings] as Settings {
            - User preferences
            - Theme settings
            - Account management
        }
    }
    
    package "Thread System" {
        component [ThreadCard] as ThreadCard {
            - Thread display
            - Like/dislike
            - Comments
            - Replies
            - User interactions
        }
        
        component [CreateThread] as CreateThread {
            - Thread creation form
            - Rich text editor
            - File attachments
            - Topic selection
        }
        
        component [SimpleCreateThread] as SimpleCreateThread {
            - Quick thread creation
            - Minimal UI
            - Fast posting
        }
        
        component [RealtimeChat] as RealtimeChat {
            - Live messaging
            - Typing indicators
            - Message history
            - File sharing
        }
    }
    
    package "Group System" {
        component [GroupChat] as GroupChat {
            - Group messaging
            - Member list
            - Real-time chat
            - File sharing
        }
        
        component [GroupManagement] as GroupManagement {
            - Group settings
            - Member management
            - Group editing
            - Invitation system
        }
        
        component [GroupCard] as GroupCard {
            - Group display
            - Join/leave actions
            - Group info
            - Member count
        }
    }
    
    package "UI Components" {
        component [Button] as Button
        component [Input] as Input
        component [Modal] as Modal
        component [Toast] as Toast
        component [LoadingState] as LoadingState
        component [Avatar] as Avatar
        component [Badge] as Badge
        component [Card] as Card
        component [Dropdown] as Dropdown
        component [FileUpload] as FileUpload
        component [ImageGallery] as ImageGallery
        component [VideoPlayer] as VideoPlayer
        component [AudioPlayer] as AudioPlayer
        component [RichTextEditor] as RichTextEditor
        component [MarkdownEditor] as MarkdownEditor
        component [EmojiPicker] as EmojiPicker
        component [ThemeToggle] as ThemeToggle
        component [WeatherWidget] as WeatherWidget
        component [WeatherEffects] as WeatherEffects
    }
    
    package "Utility Components" {
        component [InfiniteScroll] as InfiniteScroll
        component [VirtualScroll] as VirtualScroll
        component [LazyLoad] as LazyLoad
        component [CommandPalette] as CommandPalette
        component [DataTable] as DataTable
        component [KanbanBoard] as KanbanBoard
        component [Calendar] as Calendar
        component [Chart] as Chart
        component [ProgressBar] as ProgressBar
        component [Pagination] as Pagination
        component [Breadcrumb] as Breadcrumb
        component [Tabs] as Tabs
        component [Accordion] as Accordion
        component [Carousel] as Carousel
        component [Drawer] as Drawer
        component [Popover] as Popover
        component [Tooltip] as Tooltip
        component [ContextMenu] as ContextMenu
        component [DragAndDrop] as DragAndDrop
        component [FormBuilder] as FormBuilder
        component [CodeEditor] as CodeEditor
        component [HashtagInput] as HashtagInput
        component [Checkbox] as Checkbox
        component [Radio] as Radio
        component [Switch] as Switch
        component [Textarea] as Textarea
        component [Skeleton] as Skeleton
        component [Progress] as Progress
        component [Alert] as Alert
    }
    
    package "Admin System" {
        component [AdminPanel] as AdminPanel {
            - Admin dashboard
            - User management
            - Content moderation
        }
        
        component [DailyTopicBanner] as DailyTopicBanner {
            - Daily topic display
            - Topic promotion
        }
        
        component [TopicSubmission] as TopicSubmission {
            - Topic submission form
            - Topic creation
        }
        
        component [TopicDays] as TopicDays {
            - Topic calendar
            - Topic history
        }
    }
    
    package "Custom Hooks" {
        component [useLoading] as useLoading {
            - Loading state management
            - Error handling
            - Async operations
        }
        
        component [useRealtimeNotifications] as useRealtimeNotifications {
            - Real-time notification handling
            - Notification updates
        }
        
        component [useWebSocket] as useWebSocket {
            - WebSocket connection management
            - Message handling
        }
    }
}

' Layout and Provider Relationships
Layout --> Providers : wraps
Providers --> ErrorBoundary : error handling
Providers --> WeatherTheme : theme management
Providers --> UserCtx : provides
Providers --> ThreadCtx : provides
Providers --> GroupCtx : provides
Providers --> WSCtx : provides
Providers --> NotifCtx : provides
Providers --> ToastCtx : provides
Providers --> TopicCtx : provides
Providers --> WeatherCtx : provides

' Main App Structure
Layout --> MainApp : renders
MainApp --> AuthPage : authentication
MainApp --> Page : landing
MainApp --> Sidebar : navigation
MainApp --> KeyboardShortcuts : shortcuts

' Core Feature Integration
MainApp --> Feed : home tab
MainApp --> Profile : profile tab
MainApp --> Groups : groups tab
MainApp --> Notifications : notifications tab
MainApp --> Search : search tab
MainApp --> Settings : settings tab

' Thread System Integration
Feed --> ThreadCard : displays threads
Feed --> CreateThread : creates threads
Feed --> SimpleCreateThread : quick create
ThreadCard --> RealtimeChat : live chat
ThreadCard --> Avatar : user display
ThreadCard --> Button : interactions
ThreadCard --> Modal : modals

' Group System Integration
Groups --> GroupChat : group messaging
Groups --> GroupManagement : group admin
Groups --> GroupCard : group display
GroupChat --> RealtimeChat : live messaging
GroupChat --> FileUpload : file sharing
GroupChat --> ImageGallery : media display
GroupChat --> VideoPlayer : video content
GroupChat --> AudioPlayer : audio content

' UI Components Usage
MainApp --> Button : actions
MainApp --> Input : forms
MainApp --> Modal : overlays
MainApp --> Toast : notifications
MainApp --> LoadingState : loading
MainApp --> ThemeToggle : theme switching
MainApp --> WeatherWidget : weather display
MainApp --> WeatherEffects : weather effects

' Admin Integration
MainApp --> AdminPanel : admin access
AdminPanel --> DailyTopicBanner : topic management
AdminPanel --> TopicSubmission : topic creation
AdminPanel --> TopicDays : topic calendar

' Context Dependencies
MainApp --> UserCtx : user state
MainApp --> ThreadCtx : thread state
MainApp --> GroupCtx : group state
MainApp --> WSCtx : real-time
MainApp --> NotifCtx : notifications
MainApp --> ToastCtx : toasts
MainApp --> TopicCtx : topics
MainApp --> WeatherCtx : weather

' Custom Hooks Usage
Feed --> useLoading : async operations
ThreadCard --> useLoading : interactions
Groups --> useLoading : group operations
Notifications --> useRealtimeNotifications : live updates
MainApp --> useWebSocket : real-time features

' UI Component Dependencies
ThreadCard --> Avatar : user display
ThreadCard --> Button : interactions
ThreadCard --> Modal : replies
GroupChat --> FileUpload : attachments
GroupChat --> ImageGallery : media
GroupChat --> VideoPlayer : videos
GroupChat --> AudioPlayer : audio
CreateThread --> RichTextEditor : content
CreateThread --> FileUpload : attachments
CreateThread --> EmojiPicker : emojis
SimpleCreateThread --> Textarea : quick input
Profile --> Avatar : profile image
Profile --> Button : actions
Groups --> Card : group display
Groups --> Modal : group creation
Search --> Input : search input
Search --> DataTable : results
Settings --> Switch : toggles
Settings --> Input : preferences
AdminPanel --> DataTable : user management
AdminPanel --> Modal : admin actions

note right of MainApp
  Central orchestrator component
  that manages navigation, state,
  and renders appropriate content
  based on active tab
end note

note right of WSCtx
  Manages WebSocket connection
  for real-time features:
  - Live chat
  - Typing indicators
  - Instant notifications
  - Thread updates
end note

note right of ThreadCtx
  Centralized thread state management:
  - Thread CRUD operations
  - Real-time updates via WebSocket
  - Search functionality
  - Thread filtering
end note

note right of GroupCtx
  Group state management:
  - Group membership
  - Group creation/management
  - Real-time group updates
  - Group chat integration
end note

note right of WeatherTheme
  Dynamic theme system:
  - Night theme
  - Rainy theme
  - Snowy theme
  - Sunny theme
  - Cloudy theme
  Based on weather data
end note

@enduml
