@startuml
left to right direction
skinparam backgroundColor #FFFFFF
skinparam usecaseBorderColor #111111
skinparam actorBorderColor #111111
skinparam shadowing false

actor "Guest" as Guest
actor "User" as User
actor "Admin" as Admin

rectangle "DomuGrauds App" {
  (View public feed) as UC_PublicFeed
  (Register) as UC_Register
  (Login) as UC_Login
  (Logout) as UC_Logout
  (View weather theme) as UC_Weather

  (View home feed) as UC_Feed
  (Create thread) as UC_CreateThread
  (Reply to thread) as UC_Reply
  (Like/Dislike) as UC_Reactions
  (Search threads/users) as UC_Search
  (Upload media) as UC_Upload
  (Manage profile) as UC_Profile
  (Follow/Unfollow user) as UC_Follow

  (View groups) as UC_ViewGroups
  (Create group) as UC_CreateGroup
  (Join/Leave group) as UC_JoinLeave
  (Invite to group) as UC_Invite
  (Group chat realtime) as UC_GroupChat

  (View notifications) as UC_Notifications
  (Realtime updates via WS) as UC_Realtime

  (View daily topics) as UC_ViewTopics
  (Submit topic idea) as UC_SubmitTopic

  (Manage users) as UC_AdminUsers
  (Manage daily topics) as UC_AdminTopics
  (Moderate threads) as UC_Moderate
}

' Guest capabilities
Guest --> UC_PublicFeed
Guest --> UC_Register
Guest --> UC_Login
Guest --> UC_Weather

' User capabilities
User --> UC_Feed
User --> UC_CreateThread
User --> UC_Reply
User --> UC_Reactions
User --> UC_Search
User --> UC_Upload
User --> UC_Profile
User --> UC_Follow
User --> UC_ViewGroups
User --> UC_CreateGroup
User --> UC_JoinLeave
User --> UC_Invite
User --> UC_GroupChat
User --> UC_Notifications
User --> UC_Realtime
User --> UC_ViewTopics
User --> UC_SubmitTopic
User --> UC_Logout

' Admin capabilities (extends User)
Admin --> UC_AdminUsers
Admin --> UC_AdminTopics
Admin --> UC_Moderate

' Dependencies / includes
UC_GroupChat ..> UC_Realtime : uses
UC_Notifications ..> UC_Realtime : uses
UC_Feed ..> UC_Realtime : uses
UC_CreateThread ..> UC_Upload : optional
UC_Profile ..> UC_Upload : avatar
UC_ViewGroups ..> UC_JoinLeave : includes
UC_CreateGroup ..> UC_Invite : optional

@enduml

