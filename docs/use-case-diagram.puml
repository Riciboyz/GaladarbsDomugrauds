@startuml
!theme plain
skinparam backgroundColor #f8f9fa
skinparam actorStyle awesome
skinparam usecaseStyle rectangle
skinparam usecase {
  BackgroundColor #e3f2fd
  BorderColor #1976d2
  FontColor #0d47a1
}
skinparam actor {
  BackgroundColor #fff3e0
  BorderColor #f57c00
