{
  "name": "domugrauds-backend",
  "version": "1.0.0",
  "description": "Backend API server for DomuGrauds social platform",
  "main": "combined-server.js",
  "scripts": {
    "start": "node combined-server.js",
    "dev": "nodemon combined-server.js",
    "test": "jest",
    "build": "echo 'No build step required for Node.js'",
    "db:init": "node database/scripts/init.js",
    "db:reset": "rm -f ../threads_app.db && npm run db:init",
    "db:migrate": "node database/migrate.js migrate",
    "db:baseline": "node database/migrate.js baseline",
    "db:drift-check": "node database/migrate.js drift-check",
    "db:status": "node database/migrate.js status"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.6",
    "openmeteo": "^1.2.1",
    "resend": "^6.1.0",
    "socket.io": "^4.7.5",
    "sqlite3": "^5.1.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^13.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "api",
    "backend",
    "social-platform",
    "express",
    "websocket"
  ],
  "author": "DomuGrauds Team",
  "license": "MIT"
}
